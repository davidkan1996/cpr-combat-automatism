<div class="rollcard cpr-af-declaration">
  <div class="rollcard-top">
    <div class="cpr-block chat-rollTitle-stat">
      <div class="text-center text-padding-top text-normal text-semi">
        {{declarations.0.weaponName}}
      </div>
      <div class="rollcard-subtitle">
        <div class="rollcard-subtitle-center text-small">
          {{#if resolved}}Resultado del ataque{{else}}Ataque declarado{{/if}}
        </div>
      </div>
    </div>
  </div>

  <div class="rollcard-bottom">
    <div class="cpr-block">
      <div class="cpr-af-attack-summary text-small">
        <span>Atacante</span><strong>{{declarations.0.attackerName}}</strong>
        <span>Arma</span><strong>{{declarations.0.weaponTypeLabel}}</strong>
        <span>Daño</span><strong>{{declarations.0.damage}}</strong>
        <span>Habilidad</span><strong>{{declarations.0.skill}}</strong>
      </div>

      <table class="cpr-af-results-table">
        <thead>
          <tr><th>Token</th><th>DV</th><th>Evasión</th><th>Ataque</th></tr>
        </thead>
        <tbody>
          {{#each rows as |row|}}
            <tr>
              <td>{{row.targetName}}</td>
              <td class="{{#if row.dvWins}}cpr-af-winner{{/if}}">
                {{row.dv}}
              </td>
              <td class="{{#if row.evasionWins}}cpr-af-winner{{/if}}">
                {{#if row.defenseDetails}}
                  <button type="button" class="cpr-af-result-button" data-cpr-af-roll-detail="{{row.defenseDetailId}}" aria-expanded="false">
                    {{row.evasion}}
                    {{#if row.defenseDetails.isCritical}}<i class="fas fa-star cpr-af-critical" data-tooltip="Crítico"></i>{{/if}}
                    {{#if row.defenseDetails.isFumble}}<i class="fas fa-skull-crossbones cpr-af-fumble" data-tooltip="Pifia"></i>{{/if}}
                  </button>
                {{else}}-{{/if}}
              </td>
              <td class="{{#if row.attackWins}}cpr-af-winner{{/if}}">
                {{#if row.attackDetails}}
                  <button type="button" class="cpr-af-result-button" data-cpr-af-roll-detail="attack" aria-expanded="false">
                    {{row.attack}}
                    {{#if row.attackDetails.isCritical}}<i class="fas fa-star cpr-af-critical" data-tooltip="Crítico"></i>{{/if}}
                    {{#if row.attackDetails.isFumble}}<i class="fas fa-skull-crossbones cpr-af-fumble" data-tooltip="Pifia"></i>{{/if}}
                  </button>
                {{else}}-{{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <div class="cpr-af-roll-detail-area">
        {{#if attackDetails}}
          <div class="cpr-af-roll-detail cpr-af-roll-detail-collapsed" data-cpr-af-detail-panel="attack" hidden>
            <strong>Tirada de ataque</strong>
            <div>Dado: {{attackDetails.initialRoll}}</div>
            {{#each attackDetails.components as |component|}}
              <div>{{component.label}}: {{component.signedValue}}</div>
            {{/each}}
            <div class="cpr-af-roll-total">Total: {{attackDetails.total}}</div>
          </div>
        {{/if}}
        {{#each rows as |row|}}
          {{#if row.defenseDetails}}
            <div class="cpr-af-roll-detail cpr-af-roll-detail-collapsed" data-cpr-af-detail-panel="{{row.defenseDetailId}}" hidden>
              <strong>Evasión de {{row.targetName}}</strong>
              <div>Dado: {{row.defenseDetails.initialRoll}}</div>
              {{#each row.defenseDetails.components as |component|}}
                <div>{{component.label}}: {{component.signedValue}}</div>
              {{/each}}
              <div class="cpr-af-roll-total">Total: {{row.defenseDetails.total}}</div>
            </div>
          {{/if}}
        {{/each}}
      </div>

      {{#if resolved}}
        {{#if allMissed}}
          <div class="cpr-af-final cpr-af-final-failure"><i class="fas fa-xmark"></i> FALLO: ningún ataque impactó.</div>
        {{/if}}
      {{/if}}

      {{#if damageRows.length}}
        <div class="cpr-af-damage-heading">
          <span><i class="fas fa-burst"></i> Aplicación de daño</span>
          <a class="cpr-af-apply-all" data-cpr-af-apply-all role="button" data-tooltip="Aplicar daño a todos los objetivos impactados">
            <i class="fas fa-bolt"></i> Aplicar a todos
          </a>
        </div>
        <table class="cpr-af-results-table cpr-af-damage-table">
          <thead><tr><th>Token</th><th>Daño</th><th><i class="fas fa-bolt"></i></th></tr></thead>
          <tbody>
            {{#each damageRows as |row|}}
              <tr>
                <td>{{row.targetName}}</td>
                <td>
                  <button type="button" class="cpr-af-result-button" data-cpr-af-roll-detail="damage" aria-expanded="false">
                    {{row.damage}}
                    {{#if ../damageDetails.isCritical}}<i class="fas fa-star cpr-af-critical" data-tooltip="Daño crítico"></i>{{/if}}
                  </button>
                </td>
                <td>
                  <button type="button" class="cpr-af-result-button" data-cpr-af-apply-damage="{{@index}}" data-tooltip="Aplicar daño a {{row.targetName}}">
                    <i class="fas fa-bolt"></i>
                  </button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        {{#if damageDetails}}
          <div class="cpr-af-roll-detail cpr-af-roll-detail-collapsed" data-cpr-af-detail-panel="damage" hidden>
            <strong>Tirada de daño</strong>
            {{#if damageDetails.formula}}<div>Fórmula: {{damageDetails.formula}}</div>{{/if}}
            {{#if damageDetails.faces.length}}
              <div>Dados:
                {{#each damageDetails.faces as |face|}}{{face}}{{#unless @last}}, {{/unless}}{{/each}}
              </div>
            {{/if}}
            {{#if damageDetails.modifierTotal}}<div>Modificadores: {{damageDetails.modifierTotal}}</div>{{/if}}
            {{#if damageDetails.bonusDamage}}<div>Daño crítico: +{{damageDetails.bonusDamage}}</div>{{/if}}
            <div class="cpr-af-roll-total">Total: {{damageDetails.total}}</div>
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
