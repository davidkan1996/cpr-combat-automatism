<div class="rollcard cpr-af-card"
     data-cpr-af-attack-id="{{attackId}}"
     data-attacker-scene-id="{{attackerSceneId}}"
     data-attacker-token-id="{{attackerTokenId}}"
     data-attacker-actor-id="{{attackerActorId}}"
     data-target-scene-id="{{targetSceneId}}"
     data-target-token-id="{{targetTokenId}}"
     data-target-actor-id="{{targetActorId}}"
     data-target-name="{{targetName}}"
     data-weapon-id="{{weaponId}}"
     data-dv="{{dv}}">
  <div class="rollcard-top">
    <div class="cpr-block chat-rollTitle-stat">
      <div class="text-center text-padding-top text-normal text-semi">
        {{weaponName}}
      </div>
      <div class="rollcard-subtitle">
        <div class="rollcard-subtitle-center text-small">
          Attack Flow{{#if groupLabel}} {{groupLabel}}{{/if}}
        </div>
      </div>
    </div>
  </div>

  <div class="rollcard-bottom">
    <div class="cpr-block">
      <div class="cpr-af-core-grid text-small">
        <span>Attacker</span><strong>{{attackerName}}</strong>
        <span>Target</span><strong>{{targetName}}</strong>
        {{#if groupLabel}}
          <span>Group</span><strong>{{groupLabel}}</strong>
        {{/if}}
        <span>Damage</span><strong>{{damage}}</strong>
        <span>Skill</span><strong>{{skill}}</strong>
        <span>Distance</span><strong>{{distanceLabel}}</strong>
        <span>DV</span><strong>{{dvLabel}}</strong>
        <span>DV Table</span><strong>{{tableName}}</strong>
        <span>Band</span><strong>{{bandLabel}}</strong>
      </div>
    </div>
  </div>

  {{#if reason}}
    <div class="rollcard-bottom">
      <div class="cpr-block text-small">{{reason}}</div>
    </div>
  {{/if}}

  <div class="rollcard-bottom">
    <div class="cpr-block cpr-af-actions">
      <button type="button" data-cpr-af-action="no-evade">No evade</button>
      <button type="button" data-cpr-af-action="evade">Si evade</button>
    </div>
  </div>
</div>
